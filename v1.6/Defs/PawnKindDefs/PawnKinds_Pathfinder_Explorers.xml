<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- Explorers Base -->
	<PawnKindDef Abstract="Ture" Name="BasePathfinderExplorersPawnKind">
		<race>Alien_Pathfinder</race>
		<label>Pathfinder Explorers Base</label>
		<defName>PathfinderExplorersBase</defName>
		<combatPower>55</combatPower>
		<defaultFactionDef>PathfinderExplorers</defaultFactionDef>
		<chemicalAddictionChance>0.01</chemicalAddictionChance>
		<backstoryCryptosleepCommonality>0.0</backstoryCryptosleepCommonality>
		<invNutrition>3.55</invNutrition>
		<inventoryOptions>
			<skipChance>0.5</skipChance>
			<subOptionsChooseOne>
				<li>
					<thingDef>Silver</thingDef>
					<countRange>125~170</countRange>
				</li>
				<li>
					<thingDef>MedicineIndustrial</thingDef>
					<countRange>
						<min>3</min>
						<max>1</max>
					</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<apparelTags>
			<li>IndustrialBasic</li>
			<li>IndustrialAdvanced</li>
			<li>PathfinderBasic</li>
			<li MayRequire="Ludeon.RimWorld.Royalty">Cape</li>
		</apparelTags>
		<backstoryCategories>
			<li>Pathfinder_Backstory</li>
		</backstoryCategories>
		<initialWillRange>16~23</initialWillRange>
		<initialResistanceRange>12~19</initialResistanceRange>
	</PawnKindDef>
